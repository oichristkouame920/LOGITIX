# LOGITIX - exemple de configuration locale
# Copiez ce fichier en .env.local uniquement si vous ne souhaitez pas utiliser
# tools/setup_local_env.php. .env.local est ignore par Git et bloque depuis le Web.
# Ne commitez jamais vos vraies valeurs.

LOGITIX_APP_ENV=development
LOGITIX_APP_URL=auto
LOGITIX_FORCE_HTTPS=false
LOGITIX_TRUST_PROXY_HTTPS=false
LOGITIX_TRUSTED_PROXY_IPS=
LOGITIX_ADMIN_REQUIRE_2FA=true
# Assistant Web LOCAL d activation/upgrade admin. Laisser false sauf pendant
# une intervention volontaire sur localhost, puis remettre false immediatement.
LOGITIX_ADMIN_BOOTSTRAP_ENABLED=false

# WampServer/MySQL local. Si Wamp utilise un autre port, remplacez 3306.
LOGITIX_DB_HOST=127.0.0.1
LOGITIX_DB_PORT=3306
LOGITIX_DB_NAME=logitix
LOGITIX_DB_USER_CLIENT=logitix_client
LOGITIX_DB_USER_ADMIN=logitix_admin
LOGITIX_DB_REQUIRE_TLS=false
LOGITIX_DB_SSL_CA=

# Recommande : stocker les mots de passe DB en base64 afin d'eviter les
# problemes de caracteres speciaux dans .env.local.
# tools/setup_local_env.php genere ces valeurs automatiquement.
LOGITIX_DB_PASS_CLIENT_B64=
LOGITIX_DB_PASS_ADMIN_B64=

# Compatibilite : LOGITIX_DB_PASS_CLIENT / LOGITIX_DB_PASS_ADMIN restent
# supportes, mais n'utilisez pas les deux formats simultanement.

# Cle applicative TOTP : 32 octets aleatoires encodes en base64.
# Laissez vide ici : tools/setup_local_env.php la genere automatiquement.
LOGITIX_TOTP_ENCRYPTION_KEY=
